// Vite environment variables
// These are baked in at build time — see .env.local for local dev overrides.

// Path prefix for the queue API (relative to the site root).
// On GitHub Pages the app is served under /personaplex-web/, so the API
// path must be absolute (leading slash) to reach the backend at the root
// of whatever host serves it.
VITE_QUEUE_API_PATH=/api

// Base URL of the PersonaPlex backend (used for the WebSocket and queue API).
VITE_QUEUE_API_URL=https://moshi.chat
